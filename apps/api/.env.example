# LifeOS API — credentials template. Copy to apps/api/.env (gitignored).
# Tokens live ONLY here (+ TickTick .tokens.json) — never in the database.

# Database (in-container: the compose service overrides this to point at db)
DATABASE_URL=postgresql://lifeos:lifeos@127.0.0.1:5432/lifeos

# GitHub — Personal Access Token (repo read scope)
GITHUB_TOKEN=

# WeRead — scan QR at https://weread.qq.com/r/weread-skills to create a wrk- key
WEREAD_API_KEY=

# Maimemo — App: 墨墨背单词 → 开放API → copy token (7-day expiry)
MAIMEMO_TOKEN=

# TickTick — developer app credentials (cn → dida365 developer platform).
# Run `npm run ticktick:auth` once to obtain the token pair.
TICKTICK_REGION=cn
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_SCOPE=tasks:read tasks:write
TICKTICK_ACCESS_TOKEN=
TICKTICK_REFRESH_TOKEN=

# TypeSafe System One (Jev) — insights select sentences, they never write them.
# Key: https://console.typesafe.ai/keys (TYPESAFE_BASE_URL is only for staging).
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

LIFEOS_TIMEZONE=Asia/Shanghai
