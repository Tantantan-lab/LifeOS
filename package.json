{
  "name": "lifeos",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --no-seed && npm run seed",
    "seed": "npm run seed --workspace apps/web",
    "rls:check": "npm run rls:check --workspace apps/web"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "supabase": "^2.117.0",
    "tsx": "^4.23.13"
  }
}
