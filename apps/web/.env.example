# LifeOS — local Supabase connection template.
# Copy to .env.local and fill from `npx supabase status -o env`.
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ — the service role key
# bypasses RLS and must never reach the client bundle.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seed owner account (local dev only)
SEED_OWNER_EMAIL=owner@lifeos.local
SEED_OWNER_PASSWORD=lifeos-local-dev
